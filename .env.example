# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored -- never commit real secrets.
#
# Production/staging values are NOT set here -- public vars go in
# wrangler.jsonc ("vars" / "env.staging.vars"), secrets are set via
# `wrangler secret put <NAME>` (and `--env staging` for the staging Worker).
# See PLAN.md's Deployment section.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only -- NEVER prefix with NEXT_PUBLIC_, never import outside
# src/lib/supabase/admin.ts or a Supabase Edge Function. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 8 (Notifications) -- Resend free-tier API key, used by the
# order-status-change Edge Function. Not needed until that phase.
RESEND_API_KEY=
