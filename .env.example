# Copy to .env.local for local development. .env.local is gitignored.
#
# ONLY public (NEXT_PUBLIC_*) vars go here -- Next.js loads .env.local itself
# and inlines these into the JS bundle at build time. Server-only secrets do
# NOT go here (see .dev.vars.example instead) -- Cloudflare Worker bindings
# are a separate mechanism that doesn't read .env* files. See README's
# "Environment variables" section for the full explanation.
#
# Production/staging public values live in wrangler.jsonc ("vars" /
# "env.staging.vars"), not here -- this file is for local dev only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
